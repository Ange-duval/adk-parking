<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="module_category_adk_parking" model="ir.module.category">
            <field name="name">ADK Parking</field>
            <field name="sequence">20</field>
        </record>

        <record id="group_adk_parking_user" model="res.groups">
            <field name="name">Agent de Parking</field>
            <field name="category_id" ref="module_category_adk_parking"/>
        </record>

        <record id="group_adk_parking_manager" model="res.groups">
            <field name="name">Manager Parking</field>
            <field name="category_id" ref="module_category_adk_parking"/>
            <field name="implied_ids" eval="[(4, ref('group_adk_parking_user')), (4, ref('account.group_account_invoice'))]"/>
            <field name="users" eval="[(4, ref('base.user_admin'))]"/>
        </record>

        <!-- Règle multi-société -->
        <record id="rule_adk_parking_company" model="ir.rule">
            <field name="name">ADK Parking: multi-company</field>
            <field name="model_id" ref="model_adk_parking"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_adk_parking_reservation_company" model="ir.rule">
            <field name="name">ADK Parking Reservation: multi-company</field>
            <field name="model_id" ref="model_adk_parking_reservation"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_adk_parking_place_company" model="ir.rule">
            <field name="name">ADK Parking Place: multi-company</field>
            <field name="model_id" ref="model_adk_parking_place"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
