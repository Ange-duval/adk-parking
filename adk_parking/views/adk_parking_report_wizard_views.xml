<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_adk_parking_report_wizard_form" model="ir.ui.view">
        <field name="name">adk.parking.report.wizard.form</field>
        <field name="model">adk.parking.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Rapport des réservations par période">
                <group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group>
                        <field name="parking_id" options="{'no_create': True}"/>
                    </group>
                </group>
                <footer>
                    <button name="action_print_report" string="Imprimer le rapport" type="object" class="btn-primary"/>
                    <button string="Annuler" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_adk_parking_report_wizard" model="ir.actions.act_window">
        <field name="name">Rapport des réservations par période</field>
        <field name="res_model">adk.parking.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
