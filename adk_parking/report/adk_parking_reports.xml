<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_adk_parking_state" model="ir.actions.report">
        <field name="name">Rapport d'état du parking</field>
        <field name="model">adk.parking</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">adk_parking.report_adk_parking_state</field>
        <field name="report_file">adk_parking.report_adk_parking_state</field>
        <field name="binding_model_id" ref="model_adk_parking"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'Etat Parking - %s' % (object.name)</field>
    </record>

    <record id="action_report_adk_parking_unpaid" model="ir.actions.report">
        <field name="name">Paiements non soldés</field>
        <field name="model">adk.parking.reservation</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">adk_parking.report_adk_parking_unpaid</field>
        <field name="report_file">adk_parking.report_adk_parking_unpaid</field>
        <field name="binding_model_id" ref="model_adk_parking_reservation"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'Paiements non soldes'</field>
    </record>

    <record id="action_report_adk_parking_ticket" model="ir.actions.report">
        <field name="name">Ticket de réservation</field>
        <field name="model">adk.parking.reservation</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">adk_parking.report_adk_parking_ticket</field>
        <field name="report_file">adk_parking.report_adk_parking_ticket</field>
        <field name="binding_model_id" ref="model_adk_parking_reservation"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'Ticket - %s' % (object.name)</field>
    </record>

    <record id="action_report_adk_parking_by_period" model="ir.actions.report">
        <field name="name">Rapport des réservations par période</field>
        <field name="model">adk.parking.reservation</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">adk_parking.report_adk_parking_by_period</field>
        <field name="report_file">adk_parking.report_adk_parking_by_period</field>
        <field name="print_report_name">'Reservations par periode'</field>
    </record>

</odoo>
