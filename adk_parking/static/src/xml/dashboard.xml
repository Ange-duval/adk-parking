<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="adk_parking.Dashboard">
        <div class="adk-dashboard p-4">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="adk-dashboard-title mb-0">Tableau de bord Parking</h2>
            </div>

            <div class="row g-3 mb-4 row-cols-1 row-cols-md-5">
                <div class="col">
                    <div class="adk-kpi-card" t-on-click="openParkings">
                        <div class="adk-kpi-label">Parkings gérés</div>
                        <div class="adk-kpi-value"><t t-esc="state.parkingCount"/></div>
                    </div>
                </div>
                <div class="col">
                    <div class="adk-kpi-card">
                        <div class="adk-kpi-label">Taux d'occupation</div>
                        <div class="adk-kpi-value"><t t-esc="state.occupationRate"/>%</div>
                    </div>
                </div>
                <div class="col">
                    <div class="adk-kpi-card" t-on-click="openReservations">
                        <div class="adk-kpi-label">Places libres aujourd'hui</div>
                        <div class="adk-kpi-value"><t t-esc="state.availableToday"/></div>
                    </div>
                </div>
                <div class="col">
                    <div class="adk-kpi-card adk-kpi-success">
                        <div class="adk-kpi-label">Chiffre d'affaires</div>
                        <div class="adk-kpi-value"><t t-esc="formatAmount(state.revenueTotal)"/></div>
                    </div>
                </div>
                <div class="col">
                    <div class="adk-kpi-card adk-kpi-warning" t-on-click="openUnpaid">
                        <div class="adk-kpi-label">Paiements en attente</div>
                        <div class="adk-kpi-value"><t t-esc="formatAmount(state.amountDue)"/></div>
                    </div>
                </div>
            </div>

            <div class="row g-3">
                <div class="col-12 col-md-5">
                    <div class="adk-panel">
                        <div class="adk-panel-title">Répartition des places</div>
                        <div class="adk-chart-wrapper">
                            <canvas t-ref="chartCanvas"/>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-md-7">
                    <div class="adk-panel">
                        <div class="adk-panel-title">Résumé</div>
                        <table class="table adk-summary-table">
                            <tbody>
                                <tr>
                                    <td>Places libres</td>
                                    <td class="text-end"><t t-esc="state.free"/></td>
                                </tr>
                                <tr>
                                    <td>Places réservées - Personnel</td>
                                    <td class="text-end"><t t-esc="state.employee"/></td>
                                </tr>
                                <tr>
                                    <td>Places réservées - Clients</td>
                                    <td class="text-end"><t t-esc="state.client"/></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </t>

</templates>
